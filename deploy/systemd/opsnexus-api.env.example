# Copy this file to:
#   /etc/opsnexus/opsnexus-api.env
# Then replace every placeholder before starting the service.

SERVER_ADDRESS=0.0.0.0:8000
SERVER_MODEL=release
SERVER_ENABLE_SWAGGER=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=autoops
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_CHARSET=utf8mb4
DB_MAX_IDLE=50
DB_MAX_OPEN=150

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=CHANGE_ME

UPLOAD_DIR=./upload/
IMAGE_HOST=

LOG_PATH=./log
LOG_NAME=sys
LOG_MODEL=console

MONITOR_PROMETHEUS_URL=http://127.0.0.1:9090
MONITOR_PUSHGATEWAY_URL=http://127.0.0.1:9091
MONITOR_AGENT_HEARTBEAT_SERVER_URL=http://127.0.0.1:8000/api/v1/monitor/agent/heartbeat
MONITOR_AGENT_HEARTBEAT_TOKEN=CHANGE_ME
MONITOR_WEBHOOK_TOKEN=CHANGE_ME

AI_ENABLED=false
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5.4
AI_REASONING_EFFORT=medium
AI_TIMEOUT_SECONDS=60
