[Unit]
Description=OpsNexus API Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/opsnexus-remote-test
EnvironmentFile=-/etc/opsnexus/opsnexus-api.env
ExecStartPre=/bin/sh -c 'command -v docker >/dev/null 2>&1 && docker start opsnexus-mysql >/dev/null 2>&1 || true'
ExecStartPre=/bin/sh -c 'command -v docker >/dev/null 2>&1 && docker start opsnexus-redis >/dev/null 2>&1 || true'
ExecStart=/opt/opsnexus-remote-test/opsnexus-api-linux-amd64 -c /opt/opsnexus-remote-test/config.yaml
Restart=always
RestartSec=5
StandardOutput=append:/opt/opsnexus-remote-test/app.out
StandardError=append:/opt/opsnexus-remote-test/app.out

[Install]
WantedBy=multi-user.target
