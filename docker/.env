# ====================================
# DevOps杩愮淮绠＄悊绯荤粺鐜鍙橀噺閰嶇疆
# ====================================
# 淇敼绔彛鍚庢墽琛? docker-compose down && docker-compose up -d

# ----------------
# 鏈嶅姟绔彛閰嶇疆
# ----------------
# 鍓嶇璁块棶绔彛(娴忚鍣ㄨ闂湴鍧€)
WEB_PORT=8088
# API鍚庣绔彛
API_PORT=8000

# Prometheus鐩戞帶绔彛
PROMETHEUS_PORT=9090

# Pushgateway鎺ㄩ€佺鍙?
PUSHGATEWAY_PORT=9091

# AlertManager 绔彛(鍙€夛紝鐢ㄤ簬 P1 鍛婅涓績鑱旇皟)
ALERTMANAGER_PORT=9093

# ----------------
# 澶栫綉璁块棶鍦板潃閰嶇疆
# ----------------
# 鍥剧墖鍜屾枃浠惰闂湴鍧€(淇敼涓哄疄闄呯殑IP鎴栧煙鍚?
# 鏍煎紡: http://your-ip:WEB_PORT 鎴?http://your-domain.com
# 绀轰緥: http://192.168.1.100:8080 鎴?http://devops.example.com
IMAGE_HOST=http://localhost:8080

# ----------------
# 鏁版嵁搴撻厤缃?
# ----------------
MYSQL_PORT=3307
# MySQL root瀵嗙爜
MYSQL_ROOT_PASSWORD=CHANGE_ME
# 鏁版嵁搴撳悕绉?
MYSQL_DATABASE=devops
# 鏁版嵁搴撶敤鎴?
DB_USER=root

# 鏁版嵁搴撲富鏈?瀹瑰櫒鐜涓嶈鏀?
DB_HOST=mysql

# 鏁版嵁搴撶鍙?瀹瑰櫒鍐呴儴绔彛,涓嶈鏀?
DB_PORT=3306

# ----------------
# Redis閰嶇疆
# ----------------
# Redis缂撳瓨绔彛
REDIS_PORT=6379
# Redis瀵嗙爜
REDIS_PASSWORD=CHANGE_ME
# Redis鍦板潃(瀹瑰櫒鐜涓嶈鏀?
REDIS_ADDR=redis:6379

# ----------------
# 鐩戞帶/鍛婅閰嶇疆
# ----------------
MONITOR_PROMETHEUS_URL=http://prometheus:9090
MONITOR_PUSHGATEWAY_URL=http://pushgateway:9091
MONITOR_AGENT_HEARTBEAT_SERVER_URL=http://devops-api:8000/api/v1/monitor/agent/heartbeat
MONITOR_AGENT_HEARTBEAT_TOKEN=CHANGE_ME
MONITOR_WEBHOOK_TOKEN=CHANGE_ME

# ----------------
# 绯荤粺閰嶇疆
# ----------------
# 鏃跺尯閰嶇疆
TZ=Asia/Shanghai

# ----------------
# AI Runtime（可选）
# ----------------
AI_ENABLED=false
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5.4
AI_REASONING_EFFORT=medium
AI_TIMEOUT_SECONDS=60
