# Copy this file to docker/.env on the server and replace all placeholder
# secrets before starting OpsNexus.

TZ=Asia/Shanghai

# Public access
WEB_PORT=8080
API_PORT=8000
IMAGE_HOST=http://10.0.0.202:8080

# Database
MYSQL_PORT=3307
MYSQL_ROOT_HOST=%
MYSQL_DATABASE=devops
MYSQL_ROOT_PASSWORD=replace-with-strong-mysql-root-password
DB_HOST=mysql
DB_PORT=3306
DB_NAME=devops
DB_USER=root
DB_PASSWORD=replace-with-strong-mysql-root-password

# Redis
REDIS_PORT=6379
REDIS_ADDR=redis:6379
REDIS_PASSWORD=replace-with-strong-redis-password

# Monitoring
PROMETHEUS_PORT=9090
PUSHGATEWAY_PORT=9091
ALERTMANAGER_PORT=9093
MONITOR_PROMETHEUS_URL=http://prometheus:9090
MONITOR_PUSHGATEWAY_URL=http://pushgateway:9091
MONITOR_AGENT_HEARTBEAT_SERVER_URL=http://devops-api:8000/api/v1/monitor/agent/heartbeat
MONITOR_AGENT_HEARTBEAT_TOKEN=replace-with-strong-agent-token
MONITOR_WEBHOOK_TOKEN=replace-with-strong-webhook-token

# Optional AI runtime
AI_ENABLED=false
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5.4
AI_REASONING_EFFORT=medium
AI_TIMEOUT_SECONDS=60
